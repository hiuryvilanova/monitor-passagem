# Copie este arquivo para ".env" e preencha.

# Hospedagem (opcional): chave grátis de https://serpapi.com (o plano grátis tem uma cota mensal de buscas).
# Sem a chave, o script busca só os voos e gera links prontos de Google Hotels, Booking e Airbnb.
SERPAPI_KEY=

# Alerta por e-mail (Gmail): crie uma "senha de app" em https://myaccount.google.com/apppasswords
# (precisa da verificação em duas etapas ativada). NÃO use a senha normal do Gmail.
EMAIL_REMETENTE=seu-email@gmail.com
EMAIL_SENHA_APP=
EMAIL_PARA=seu-email@gmail.com
